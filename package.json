{
  "name": "senswear-web-bluetooth",
  "version": "0.4.0",
  "description": "SensWear SDK for web applications using the browser Web Bluetooth API.",
  "keywords": ["senswear", "web-bluetooth", "bluetooth", "ble", "wearable", "typescript"],
  "author": "Sensera Technologies",
  "license": "MIT",
  "homepage": "https://sens-wear.com",
  "type": "module",
  "main": "dist/cjs/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/cjs/index.d.ts", "default": "./dist/cjs/index.js" }
    }
  },
  "files": ["dist", "src", "README.md", "LICENSE", "examples", "VALIDATION.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node scripts/finalize-build.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  },
  "engines": { "node": ">=18" }
}
